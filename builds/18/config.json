            "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>html,body{margin:0;height:100%}body{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:32px;background:#ffffff;--c:#0f766e}img{width:96px;height:96px;border-radius:22px;object-fit:cover}.ld{display:flex;align-items:center;justify-content:center}\n.l-ring{width:42px;height:42px;border:5px solid color-mix(in srgb,var(--c) 20%,transparent);border-top-color:var(--c);border-radius:50%;animation:sp 1s linear infinite}\n@keyframes sp{to{transform:rotate(360deg)}}\n.l-dots{display:flex;gap:7px}.l-dots b{width:11px;height:11px;border-radius:50%;background:var(--c);animation:bn 1s infinite ease-in-out}.l-dots b:nth-child(2){animation-delay:.15s}.l-dots b:nth-child(3){animation-delay:.3s}\n@keyframes bn{0%,80%,100%{transform:scale(.4);opacity:.4}40%{transform:scale(1);opacity:1}}\n.l-pulse{width:42px;height:42px;border-radius:50%;background:var(--c);animation:pl 1.2s infinite ease-out}\n@keyframes pl{0%{transform:scale(.3);opacity:1}100%{transform:scale(1.15);opacity:0}}\n.l-bars{display:flex;gap:5px;align-items:center;height:42px}.l-bars b{width:7px;height:100%;border-radius:4px;background:var(--c);animation:br 1s infinite ease-in-out}\n.l-bars b:nth-child(2){animation-delay:.1s}.l-bars b:nth-child(3){animation-delay:.2s}.l-bars b:nth-child(4){animation-delay:.3s}\n@keyframes br{0%,100%{transform:scaleY(.3)}50%{transform:scaleY(1)}}\n.l-dual{width:42px;height:42px;border-radius:50%;border:5px solid transparent;border-top-color:var(--c);border-bottom-color:var(--c);animation:sp 1s linear infinite}\n.l-prog{display:block;width:120px;height:7px;border-radius:9px;background:color-mix(in srgb,var(--c) 20%,transparent);overflow:hidden}.l-prog b{display:block;height:100%;width:40%;border-radius:9px;background:var(--c);animation:pg 1.2s infinite ease-in-out}\n@keyframes pg{from{transform:translateX(-100%)}to{transform:translateX(260%)}}\n.l-orbit{display:block;width:42px;height:42px;position:relative;animation:sp 1.1s linear infinite}.l-orbit b{position:absolute;top:0;left:50%;margin-left:-6px;width:12px;height:12px;border-radius:50%;background:var(--c)}\n.l-square{width:32px;height:32px;background:var(--c);border-radius:8px;animation:fl 1.3s infinite ease-in-out}\n@keyframes fl{50%{transform:rotate(180deg) scale(.6);border-radius:50%}100%{transform:rotate(360deg)}}</style></head><body><img src=\"icon.png\"><div class=\"ld\"><i class=\"l-bars\"><b></b><b></b><b></b><b></b></i></div></body></html>"
